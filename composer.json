{
    "name": "web-nomads/wn-raisenow",
    "type": "typo3-cms-extension",
    "version": "1.1.1",
    "description": "RaiseNow donation forms for TYPO3: configure Tamaro donation widgets in the backend - amounts, currencies, payment methods, purposes, thank-you page - and place them on any page as a content element.",
    "keywords": ["TYPO3", "CMS", "RaiseNow", "Tamaro", "donation", "fundraising", "TWINT"],
    "homepage": "https://github.com/web-nomads/wn-raisenow",
    "license": "GPL-2.0-or-later",
    "support": {
        "issues": "https://github.com/web-nomads/wn-raisenow/issues",
        "source": "https://github.com/web-nomads/wn-raisenow"
    },
    "authors": [
        {
            "name": "Marcel Marty",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "typo3/cms-backend": "^12.4 || ^13.4 || ^14.3",
        "typo3/cms-core": "^12.4 || ^13.4 || ^14.3",
        "typo3/cms-fluid": "^12.4 || ^13.4 || ^14.3",
        "typo3/cms-frontend": "^12.4 || ^13.4 || ^14.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.70",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "typo3/cms-fluid-styled-content": "^12.4 || ^13.4 || ^14.3",
        "typo3/coding-standards": "^0.8",
        "typo3/testing-framework": "^8.2 || ^9.3"
    },
    "suggest": {
        "typo3/cms-fluid-styled-content": "Provides lib.contentElement, which the content element is rendered with"
    },
    "autoload": {
        "psr-4": {
            "WebNomads\\WnRaisenow\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebNomads\\WnRaisenow\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "wn_raisenow",
            "Package": {
                "providesPackages": {}
            },
            "web-dir": ".Build/Web"
        }
    },
    "scripts": {
        "test": "@test:unit",
        "test:unit": "phpunit --testsuite Unit",
        "test:functional": "phpunit -c phpunit.functional.xml",
        "stan": "phpstan analyse --no-progress --memory-limit=1G",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "ci": [
            "@cs:check",
            "@stan",
            "@test:unit",
            "@test:functional"
        ]
    },
    "config": {
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true
        },
        "sort-packages": true,
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin"
    }
}
